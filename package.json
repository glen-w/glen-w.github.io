{
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "1.4.0",
    "prettier": "3.1.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:links": "python3 scripts/check_links.py",
    "check:links:site": "python3 scripts/check_links.py --site _site",
    "prerelease:format": "npm run format:check",
    "prerelease:links": "npm run check:links"
  }
}
