 <path stroke-linecap=round stroke-linejoin=round d="M6 9V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5M6 18h12a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2Zm0 0v2a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-2"></path>
