 <div class="t-content t-content--article" id=main-content tabindex=-1>
 <nav class=m-breadcrumb role=navigation>
 <ol class=m-breadcrumb__list>
 <li class=m-breadcrumb__list__item><a href=https://www.france24.com/en/ class=m-breadcrumb__list__item__link>
 Home
 </a></li>
 <li class=m-breadcrumb__list__item><a href=https://www.france24.com/en/live-news/ class=m-breadcrumb__list__item__link>
