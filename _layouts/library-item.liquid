---
layout: default
---

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post library-item-page">
  {% include library/hero.liquid %}

  <article class="post-content library-item-body">
    {% comment %}Overview / Abstract — omit when empty or identical to standfirst{% endcomment %}
    {% assign abstract_text = page.abstract | default: '' | strip %}
    {% assign standfirst_text = page.standfirst | default: '' | strip %}
    {% assign description_text = page.description | default: '' | strip %}
    {% assign show_body_text = false %}
    {% assign body_heading = 'Abstract' %}
    {% assign body_text = '' %}

    {% if abstract_text != '' %}
      {% if standfirst_text != '' and abstract_text == standfirst_text %}
        {% assign show_body_text = false %}
      {% else %}
        {% assign show_body_text = true %}
        {% assign body_heading = 'Abstract' %}
        {% assign body_text = abstract_text %}
      {% endif %}
    {% elsif description_text != '' and description_text != standfirst_text and description_text != page.title %}
      {% assign show_body_text = true %}
      {% assign body_heading = 'Overview' %}
      {% assign body_text = description_text %}
    {% endif %}

    {% if show_body_text %}
      <section class="library-abstract" aria-labelledby="library-abstract-heading">
        <h2 id="library-abstract-heading">{{ body_heading }}</h2>
        <div class="abstract-content">
          {% assign body_with_br = body_text | newline_to_br %}
          {% assign body_lines = body_with_br | split: '<br />' %}
          {% if body_text contains ' • ' %}
            <div class="library-abstract-rich">
              {% assign in_list = false %}
              {% for line in body_lines %}
                {% assign clean_line = line | strip %}
                {% if clean_line contains ' • ' %}
                  {% unless in_list %}<ul>{% assign in_list = true %}{% endunless %}
                  {% assign bullet_text = clean_line | split: ' • ' | last | strip %}
                  <li>{{ bullet_text }}</li>
                {% else %}
                  {% if in_list %}</ul>{% assign in_list = false %}{% endif %}
                  {% if clean_line != '' %}<p>{{ clean_line }}</p>{% endif %}
                {% endif %}
              {% endfor %}
              {% if in_list %}</ul>{% endif %}
            </div>
          {% else %}
            {% for para in body_lines %}
              {% assign para_clean = para | strip %}
              {% if para_clean != '' %}
                <p>{{ para_clean }}</p>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </section>
    {% endif %}

    {% include library/event_details.liquid %}

    {% include library/materials.liquid %}

    {% comment %}Contribution / quotes{% endcomment %}
    {% assign quotes_count = page.quotes | size | default: 0 %}
    {% assign role_text = page.role | default: '' | strip %}

    {% if page.is_event %}
      {% if quotes_count > 0 %}
        <section class="library-quotes" aria-labelledby="library-quotes-heading">
          <h2 id="library-quotes-heading">Key quotes</h2>
          <ul class="quotes-list">
            {% for quote in page.quotes %}
              {% assign quote_text = quote | strip %}
              {% if quote_text != '' %}
                <li>{{ quote_text }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    {% elsif quotes_count > 0 or role_text != '' %}
      <section class="library-contribution" aria-labelledby="library-contribution-heading">
        <h2 id="library-contribution-heading">Contribution</h2>
        {% if role_text != '' %}
          <p class="library-contribution-role">Role: {{ role_text | capitalize }}</p>
        {% endif %}
        {% if quotes_count > 0 %}
          <ul class="quotes-list">
            {% for quote in page.quotes %}
              {% assign quote_text = quote | strip %}
              {% if quote_text != '' %}
                <li>{{ quote_text }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endif %}

    <div id="markdown-content" class="library-markdown-content">
      {{ content }}
    </div>

    <script>
    (function() {
      setTimeout(function() {
        const contentDiv = document.getElementById('markdown-content');
        if (!contentDiv) return;

        // Hide leftover redundant markdown sections if any remain
        ['Abstract', 'Publication Details', 'Keywords', 'Links and Resources'].forEach(function(sectionName) {
          const heading = Array.from(contentDiv.querySelectorAll('h2'))
            .find(h => h.textContent.trim() === sectionName);
          if (heading) {
            heading.style.display = 'none';
            let el = heading.nextElementSibling;
            while (el && el.tagName !== 'H2') {
              el.style.display = 'none';
              el = el.nextElementSibling;
            }
          }
        });

        if (!contentDiv.textContent.trim()) {
          contentDiv.style.display = 'none';
        }

        const contentImages = contentDiv.querySelectorAll('img');
        const contentImageList = [];
        contentImages.forEach(function(img) {
          const src = (img.src || '').toLowerCase();
          if (src.includes('thumbnail')) {
            img.style.display = 'none';
            return;
          }
          contentImageList.push(img);
          img.style.cursor = 'pointer';
          img.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const galleryImagesList = contentImageList.map(function(galleryImg) {
              return { src: galleryImg.src, alt: galleryImg.alt || {{ page.title | jsonify }} };
            });
            const currentIndex = contentImageList.indexOf(img);
            if (typeof openImageModal === 'function') {
              openImageModal(img.src, img.alt || {{ page.title | jsonify }}, galleryImagesList, currentIndex);
            }
          });
        });
      }, 50);
    })();
    </script>

    {% include library/gallery.liquid %}
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}

  <div class="library-return-footer">
    <a href="{{ '/library/' | relative_url }}?action=jump#{{ page.bibtex_key }}">
      ← Back to library
    </a>
  </div>
</div>
