---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    
    <!-- Entry type and basic metadata -->
    <p class="post-meta">
      <i class="fa-solid fa-file-lines fa-sm"></i> {{ page.entry_type }}
      {% if page.year %}
        &nbsp;&middot;&nbsp; <i class="fa-solid fa-calendar fa-sm"></i> {{ page.year }}
      {% endif %}
      {% if page.venue %}
        &nbsp;&middot;&nbsp; <i class="fa-solid fa-building fa-sm"></i> {{ page.venue }}
      {% endif %}
      {% if page.location %}
        &nbsp;&middot;&nbsp; <i class="fa-solid fa-location-dot fa-sm"></i> {{ page.location }}
      {% endif %}
    </p>

    <!-- Authors -->
    {% if page.authors and page.authors.size > 0 %}
      <p class="post-meta">
        <i class="fa-solid fa-user fa-sm"></i> 
        {% for author in page.authors %}
          {{ author }}{% unless forloop.last %}, {% endunless %}
        {% endfor %}
      </p>
    {% endif %}

    <!-- Description -->
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}

    <!-- Tags and Categories -->
    <p class="post-tags">
      <a href="{{ year | prepend: '/library/' | relative_url }}"> 
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} 
      </a>
      {% if tags != '' %}
        &nbsp;&middot;&nbsp;
        {% for tag in page.tags %}
          <a href="{{ tag | slugify | prepend: '/library/tag/' | relative_url }}"> 
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          </a>
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp;&middot;&nbsp;
        {% for category in page.categories %}
          <a href="{{ category | slugify | prepend: '/library/category/' | relative_url }}"> 
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          </a>
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>

    <!-- Action buttons for PDFs, links, etc. -->
    {% if page.pdf or page.url or page.doi %}
      <div class="library-actions">
        {% if page.pdf %}
          <a href="{{ page.pdf | prepend: '/assets/pdf/' | relative_url }}" 
             class="btn btn-primary btn-sm" 
             target="_blank">
            <i class="fa-solid fa-file-pdf fa-sm"></i> View PDF
          </a>
        {% endif %}
        {% if page.url %}
          <a href="{{ page.url }}" 
             class="btn btn-outline-primary btn-sm" 
             target="_blank">
            <i class="fa-solid fa-external-link fa-sm"></i> External Link
          </a>
        {% endif %}
        {% if page.doi %}
          <a href="https://doi.org/{{ page.doi }}" 
             class="btn btn-outline-secondary btn-sm" 
             target="_blank">
            <i class="fa-solid fa-link fa-sm"></i> DOI
          </a>
        {% endif %}
      </div>
    {% endif %}

    <hr>
  </header>

  <!-- Return to library link -->
  <div class="library-return-link" style="margin-bottom: 2rem;">
    <a href="/library/?action=jump#{{ page.bibtex_key }}" class="btn btn-outline-secondary btn-sm">
      <i class="fas fa-arrow-left"></i> Return to Library
    </a>
  </div>

  <article class="post-content">
    <!-- Preview image if available -->
    {% if page.preview %}
      <figure class="library-preview">
        <img src="{{ page.preview | prepend: '/assets/img/publications/' | relative_url }}" 
             alt="{{ page.title }} preview" 
             class="img-fluid">
        <figcaption>
          Preview of <em>{{ page.title }}</em>
        </figcaption>
      </figure>
    {% endif %}

    <!-- Abstract section -->
    {% if page.abstract %}
      <div class="library-abstract">
        <h3>Abstract</h3>
        <p>{{ page.abstract }}</p>
      </div>
    {% endif %}

    <!-- Main content -->
    <div id="markdown-content">
      {{ content }}
    </div>

    <!-- Image gallery if available -->
    {% if page.gallery and page.gallery.size > 1 %}
      <div class="library-gallery">
        <h3>Gallery</h3>
        <div class="row">
          {% for image in page.gallery %}
            <div class="col-md-4 col-sm-6 mb-3">
              <a href="{{ image | prepend: '/assets/img/publications/' | relative_url }}" 
                 data-lightbox="gallery" 
                 data-title="{{ page.title }}">
                <img src="{{ image | prepend: '/assets/img/publications/' | relative_url }}" 
                     alt="{{ page.title }} image {{ forloop.index }}" 
                     class="img-fluid rounded">
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </article>

  <!-- Comments if enabled -->
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

<style>
  /* Library-specific styles that extend existing classes */
  .library-actions {
    margin: 1rem 0;
  }
  
  .library-actions .btn {
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .library-preview {
    float: right;
    margin: 0 0 1rem 1rem;
    max-width: 300px;
  }
  
  .library-preview img {
    width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }
  
  .library-preview figcaption {
    font-size: 0.875rem;
    color: var(--global-text-color-light);
    text-align: center;
    margin-top: 0.5rem;
  }
  
  .library-abstract {
    background-color: var(--global-bg-color);
    border-left: 4px solid var(--global-theme-color);
    padding: 1rem;
    margin: 1.5rem 0;
    border-radius: 0 0.375rem 0.375rem 0;
  }
  
  .library-abstract h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--global-theme-color);
  }
  
  .library-gallery {
    margin-top: 2rem;
  }
  
  .library-gallery h3 {
    margin-bottom: 1rem;
    color: var(--global-theme-color);
  }
  
  .library-gallery img {
    transition: transform 0.2s ease-in-out;
  }
  
  .library-gallery img:hover {
    transform: scale(1.05);
  }
  
  /* Responsive adjustments */
  @media screen and (max-width: 768px) {
    .library-preview {
      float: none;
      margin: 0 0 1rem 0;
      max-width: 100%;
    }
    
    .library-actions .btn {
      display: block;
      width: 100%;
      margin-right: 0;
      margin-bottom: 0.5rem;
    }
  }
  
  /* Print styles */
  @media print {
    .library-actions {
      display: none;
    }
    
    .library-preview {
      float: none;
      margin: 0 0 1rem 0;
      max-width: 200px;
    }
  }
</style>
