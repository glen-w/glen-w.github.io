---
layout: default
---
<div class="post">
  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.81}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        <!-- Social -->
        {% if page.social %}
          <div class="social profile-social">
            <div class="contact-icons">{% include social.liquid %}</div>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div id="selectedPublicationsContainer">
        <h2>
          <a href="{{ '/library/' | relative_url }}" style="color: inherit">selected publications</a>
        </h2>
        {% include selected_papers_home.liquid %}
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<!-- Selected Publications Styles -->
<style>
#selectedPublicationsContainer {
  margin: 2rem 0;
}

#selectedPublicationsContainer h2 {
  font-size: 1.25rem;
}

/* Home page selected publications styling */
.publications-home ol.bibliography li {
  margin-bottom: 1.25rem;
}

.publications-home h2.bibliography {
  display: none;
}

/* Profile social icons styling */
.profile-social {
  margin-top: 1rem;
  text-align: center;
}

.profile-social .contact-icons {
  font-size: 2rem;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.profile-social .contact-icons a {
  display: inline-block;
}

.profile-social .contact-icons a i::before {
  font-size: 1.5rem;
}

.profile-social .contact-icons a img {
  width: 2rem;
  height: 2rem;
  margin-bottom: 0;
}

.profile-social .contact-icons a svg {
  width: 2rem;
  height: 2rem;
  margin-bottom: 0;
}

.profile-social .contact-icons a svg image {
  width: 2rem;
  height: 2rem;
}

.profile-social .contact-note {
  margin-top: 0.5rem;
  font-size: 0.875rem;
}

/* Read More Toggle Styles - Progressive Enhancement */
/* Content is visible by default (works without JavaScript) */
/* Only hide when JavaScript is enabled */
.js-enabled .read-more-content.read-more-collapsed {
  display: none;
}

.js-enabled .read-more-content.read-more-expanded {
  display: block;
}

/* Read More Toggle Button (match in-body link style: theme color, dotted underline) */
.read-more-toggle {
  background: none;
  border: none;
  color: var(--global-theme-color);
  cursor: pointer;
  font-family: inherit;
  font-size: inherit;
  padding: 0;
  text-decoration: underline dotted;
  margin: 1rem 0;
  display: inline-block;
  -webkit-tap-highlight-color: transparent;
}

/* Same as `a:hover` in _base.scss */
.read-more-toggle:hover {
  color: var(--global-theme-color);
  text-decoration: underline;
}

/* When focused but not hovered (e.g. keyboard tab), keep dotted like default links */
.read-more-toggle:focus:not(:hover) {
  text-decoration: underline dotted;
}

.read-more-toggle:active {
  color: var(--global-theme-color);
  text-decoration: underline;
}

.read-more-toggle:focus:not(:focus-visible) {
  outline: none;
}

.read-more-toggle:focus-visible {
  color: var(--global-theme-color);
  text-decoration: underline dotted;
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

/* Smooth transition for content */
.read-more-content {
  transition: opacity 0.3s ease;
}
</style>

<!-- Read More Toggle Script -->
<script src="{{ '/assets/js/read-more.js' | relative_url | bust_file_cache }}" type="text/javascript"></script>
