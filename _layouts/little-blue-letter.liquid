<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{ page.title }}</title>
    <meta name="description" content="{{ page.description | default: site.description }}">
    <link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">
    <meta property="og:title" content="{{ page.title }}">
    <meta property="og:description" content="{{ page.description | default: site.description }}">
    <meta property="og:url" content="{{ page.url | replace:'index.html','' | absolute_url }}">
    <meta property="og:type" content="website">
    {% if page.img %}
      <meta property="og:image" content="{{ page.img | absolute_url }}">
    {% endif %}
    <link
      rel="icon"
      href="{{ '/assets/img/projects/thumbs/little_blue_letter_logo.png' | relative_url }}"
      type="image/png"
    >
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        min-height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #dddddd;
        background-image: url("{{ '/assets/img/little-blue-letter/bg.png' | relative_url }}");
        background-attachment: fixed;
        background-repeat: repeat;
        color: #555;
        font-family: Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .lbl-shell {
        width: min(40rem, calc(100% - 2rem));
        background: #fff;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.12);
        border-radius: 3px;
        padding: 2.25rem 2rem 2rem;
        text-align: center;
      }
      .lbl-logo {
        display: block;
        width: 220px;
        max-width: 70%;
        height: auto;
        margin: 0 auto 1.25rem;
      }
      .lbl-title {
        margin: 0 0 0.75rem;
        font-family: Monaco, "Lucida Console", monospace;
        font-weight: normal;
        font-size: clamp(1.35rem, 4vw, 1.85rem);
        color: #81b3cd;
        letter-spacing: 0.01em;
      }
      .lbl-tagline {
        margin: 0 0 1.25rem;
        font-size: 1.05rem;
        line-height: 1.45;
        color: #555;
      }
      .lbl-status {
        margin: 0 0 1.5rem;
        color: #666;
      }
      .lbl-links {
        margin: 0;
        font-size: 0.95rem;
      }
      .lbl-links a {
        color: #3466cc;
        text-decoration: none;
      }
      .lbl-links a:hover,
      .lbl-links a:focus {
        text-decoration: underline;
      }
      .lbl-sep {
        margin: 0 0.55rem;
        color: #999;
      }
    </style>
    {% if site.enable_umami %}
      {% assign umami_id = page.umami_website_id | default: "81f9fc36-a66c-405b-9543-ef9b9fb08c70" %}
      <script
        defer
        src="{{ site.umami_src }}"
        data-website-id="{{ umami_id }}"
      ></script>
    {% endif %}
  </head>
  <body>
    {{ content }}
  </body>
</html>
