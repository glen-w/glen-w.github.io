{% if include.repository.repo %}
  {% assign repo_full = include.repository.repo %}
{% else %}
  {% assign repo_full = include.repository %}
{% endif %}

{% assign repo_img = include.repository.img %}
{% assign repo_name = include.repository.name %}
{% assign repo_description = include.repository.description %}
{% assign repo_page = include.repository.url %}
{% assign repo_page_label = include.repository.url_label %}
{% assign repo_parts = repo_full | split: '/' %}
{% unless repo_name %}
  {% assign repo_name = repo_parts.last %}
{% endunless %}
{% unless repo_page_label %}
  {% assign repo_page_label = "Site" %}
{% endunless %}
{% assign repo_github = "https://github.com/" | append: repo_full %}
{% if repo_page and repo_page != "" %}
  {% unless repo_page contains "://" %}
    {% assign repo_page = repo_page | relative_url %}
  {% endunless %}
{% endif %}

<article class="repo-card">
  <div class="repo-heading">
    {% if repo_img %}
      <img class="repo-logo" src="{{ repo_img | relative_url }}" alt="">
    {% else %}
      <i class="fa-brands fa-github repo-logo-icon" aria-hidden="true"></i>
    {% endif %}
    <div class="repo-body">
      <h2 class="repo-name">{{ repo_name }}</h2>
      {% if repo_description %}
        <p class="repo-description">{{ repo_description }}</p>
      {% endif %}
      <p class="repo-links">
        <a href="{{ repo_github }}">GitHub</a>
        {% if repo_page and repo_page != "" %}
          <span class="repo-links-sep" aria-hidden="true">·</span>
          <a href="{{ repo_page }}">{{ repo_page_label }}</a>
        {% endif %}
      </p>
    </div>
  </div>
</article>
