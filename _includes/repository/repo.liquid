{% if include.repository.repo %}
  {% assign repo_full = include.repository.repo %}
{% else %}
  {% assign repo_full = include.repository %}
{% endif %}

{% assign repo_img = include.repository.img %}
{% assign repo_name = include.repository.name %}
{% assign repo_description = include.repository.description %}
{% assign repo_parts = repo_full | split: '/' %}
{% assign repo_github = 'https://github.com/' | append: repo_full %}
{% assign matched_project = site.projects | where: 'github', repo_github | first %}
{% assign repo_website = matched_project.website | default: include.repository.website %}
{% assign repo_docs = matched_project.docs | default: include.repository.docs %}
{% if matched_project.title %}
  {% assign repo_name = matched_project.title %}
{% endif %}
{% unless repo_name %}
  {% assign repo_name = repo_parts.last %}
{% endunless %}
{% assign project_href = matched_project.url %}

<article class="repo-card">
  <div class="repo-heading">
    {% if repo_img %}
      <img class="repo-logo" src="{{ repo_img | relative_url }}" alt="">
    {% else %}
      <i class="fa-brands fa-github repo-logo-icon" aria-hidden="true"></i>
    {% endif %}
    <div class="repo-body">
      <h2 class="repo-name">
        {% if project_href %}
          <a href="{{ project_href | relative_url }}">{{ repo_name }}</a>
        {% else %}
          {{ repo_name }}
        {% endif %}
      </h2>
      {% if repo_description %}
        <p class="repo-description">{{ repo_description }}</p>
      {% endif %}
      <div class="repo-links">
        {% include project_card_links.liquid github=repo_github website=repo_website docs=repo_docs %}
      </div>
    </div>
  </div>
</article>
