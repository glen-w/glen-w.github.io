<div class="col">
  <div class="card h-100 hoverable" data-category="{{ project.category }}">
    <a class="project-card-link" href="{{ project.url | relative_url }}">
      {% if project.img %}
        <div class="project-thumb-frame">
          {% if project.img_dark %}
            <img class="card-img-top project-thumb-img only-light" src="{{ project.img | relative_url }}" alt="{{ project.title }} logo" />
            <img class="card-img-top project-thumb-img only-dark" src="{{ project.img_dark | relative_url }}" alt="" />
          {% else %}
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes = "250px"
            alt="project thumbnail"
            class="card-img-top project-thumb-img"
          %}
          {% endif %}
        </div>
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    {% include project_card_links.liquid %}
  </div>
</div>
