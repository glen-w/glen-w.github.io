.timeline-panel .meta,
.timeline-panel .timeline-links {
  margin: 0 0 0.75rem;
  color: var(--global-text-color-light);
  font-size: 0.9rem;
}

.timeline-panel ul {
  margin: 0;
  padding-left: 1.1rem;
