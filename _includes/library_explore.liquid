}

.person-profile-icons {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  margin-left: 0.2rem;
  vertical-align: middle;
}

.person-profile-icon {
  color: var(--global-text-color-light);
  font-size: 0.85em;
  line-height: 1;
  text-decoration: none;
}

.person-profile-icon:hover,
.person-profile-icon:focus {
