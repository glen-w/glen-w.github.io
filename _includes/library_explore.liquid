}

.citations-filters {
  display: inline-flex;
  gap: 0.35rem;
}

.citations-filter {
  border: 1px solid var(--global-divider-color);
  background: transparent;
  color: var(--global-text-color);
  font: inherit;
  font-size: 0.9rem;
  padding: 0.25rem 0.6rem;
  cursor: pointer;
}

.citations-filter.is-active {
  border-color: var(--global-theme-color);
  color: var(--global-theme-color);
}

.people-list {
  margin-top: 0.75rem;
  max-width: 40rem;
}

.people-list > summary {
  background: none;
  border: none;
  color: var(--global-theme-color);
  cursor: pointer;
  display: inline-block;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  list-style: none;
  margin: 1rem 0;
  padding: 0;
  text-decoration: underline dotted;
  -webkit-tap-highlight-color: transparent;
}

.people-list > summary::-webkit-details-marker {
  display: none;
}

.people-list > summary::after {
  content: " >";
}

.people-list[open] > summary::after {
  content: none;
}

.people-list[open] > summary::before {
  content: "< ";
}

.people-list > summary:hover {
  color: var(--global-theme-color);
  text-decoration: underline;
}

.people-list > summary:focus:not(:hover) {
  text-decoration: underline dotted;
}

.people-list > summary:active {
  color: var(--global-theme-color);
  text-decoration: underline;
}

.people-list > summary:focus:not(:focus-visible) {
  outline: none;
}

.people-list > summary:focus-visible {
  color: var(--global-theme-color);
  text-decoration: underline dotted;
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.people-list > summary .people-list-count {
  font-weight: inherit;
