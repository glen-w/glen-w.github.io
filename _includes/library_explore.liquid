.timeline-app {
  margin: 0 0 2rem;
}

.timeline-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-bottom: 0.75rem;
}

.timeline-modes {
  display: inline-flex;
  gap: 0.35rem;
