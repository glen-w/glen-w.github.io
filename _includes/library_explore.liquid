}

.network-legend-swatch--self {
  background: var(--global-tip-block);
  border-color: var(--global-tip-block-title);
  border-width: 1.5px;
}

.network-legend-swatch--year {
  border-radius: 2px;
  background: linear-gradient(90deg, #ffffd9, #7fcdbb, #225ea8);
}

.network-legend-swatch--cites-me {
  background: #2a6f97;
}

.network-legend-swatch--i-cite {
  background: #b5651d;
}

.network-legend-swatch--both {
  background: #5c6b73;
}

.coauthors-panel h3,
.citations-panel h3 {
  margin: 0 0 0.5rem;
  font-size: 1.05rem;
}

.coauthors-panel .meta,
.citations-panel .meta {
  margin: 0 0 0.75rem;
  color: var(--global-text-color-light);
  font-size: 0.9rem;
}

.coauthors-panel ul:not(.network-legend-list),
.citations-panel ul:not(.network-legend-list) {
