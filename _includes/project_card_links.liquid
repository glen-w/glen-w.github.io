{% if project.github or project.website or project.docs %}
  <div class="project-card-links">
    {% if project.github %}
      <a href="{{ project.github }}" data-toggle="tooltip" title="Code repository" aria-label="Code repository">
        <i class="fa-brands fa-github" aria-hidden="true"></i>
      </a>
      {% if project.github_stars %}
        <span class="stars" data-toggle="tooltip" title="GitHub Stars">
          <i class="fa-solid fa-star" aria-hidden="true"></i>
          <span id="{{ project.github_stars }}-stars"></span>
        </span>
      {% endif %}
    {% endif %}
    {% if project.website %}
      <a href="{{ project.website }}" data-toggle="tooltip" title="Website" aria-label="Website">
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
      </a>
    {% endif %}
    {% if project.docs %}
      <a href="{{ project.docs }}" data-toggle="tooltip" title="Documentation" aria-label="Documentation">
        <i class="fa-solid fa-book" aria-hidden="true"></i>
      </a>
    {% endif %}
  </div>
{% endif %}
