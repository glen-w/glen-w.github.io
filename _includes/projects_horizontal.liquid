<div class="col mb-4">
  <div class="card h-100 hoverable" data-category="{{ project.category }}">
    <a class="project-card-link" href="{{ project.url | relative_url }}">
      <div class="row no-gutters">
        {% if project.img %}
          <div class="col-md-6">
            <div class="project-thumb-frame project-thumb-frame--horizontal">
              {% if project.img_dark %}
                <img class="card-img project-thumb-img only-light" src="{{ project.img | relative_url }}" alt="{{ project.title }} logo" />
                <img class="card-img project-thumb-img only-dark" src="{{ project.img_dark | relative_url }}" alt="" />
              {% else %}
                {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img project-thumb-img" %}
              {% endif %}
            </div>
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
          </div>
        </div>
      </div>
    </a>
    {% include project_card_links.liquid %}
  </div>
</div>
