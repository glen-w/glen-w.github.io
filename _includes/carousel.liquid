{% comment %}
  Carousel include for displaying series as a horizontal scrolling carousel
  Accepts: series_projects (sorted array of items), series_name (string)
  
  Uses Swiper library for carousel functionality
{% endcomment %}

{% assign series_id = series_name | slugify %}

<div class="carousel-container" data-series-id="{{ series_id }}" data-series-name="{{ series_name }}">
  <div class="swiper carousel-swiper" id="carousel-{{ series_id }}">
    <div class="swiper-wrapper">
      {% for item in series_projects %}
        <div class="swiper-slide carousel-slide" data-image-index="{{ forloop.index0 }}">
          <div class="carousel-slide-content">
            {% include figure.liquid 
              loading="lazy" 
              path=item.img 
              class="img-fluid carousel-image" 
              alt=item.title
            %}
          </div>
        </div>
      {% endfor %}
    </div>
    
    {% comment %} Navigation arrows {% endcomment %}
    <div class="swiper-button-next carousel-button-next"></div>
    <div class="swiper-button-prev carousel-button-prev"></div>
    
    {% comment %} Pagination dots {% endcomment %}
    <div class="swiper-pagination carousel-pagination"></div>
  </div>
</div>

