<div class="col mb-4">
  <div class="card h-100 hoverable" data-category="{{ project.category }}">
    <div class="row no-gutters">
      {% if project.img %}
        <div class="{% if project.category == 'collage' %}col-md-12{% else %}col-md-6{% endif %}">
          <div class="creative-image-wrapper" data-gallery-group="{{ project.category }}-{{ project.series | default: 'misc' }}">
            <div class="creative-gallery-image-container">
              {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img creative-gallery-image" %}
            </div>
          </div>
        </div>
      {% endif %}
      {% unless project.category == 'collage' %}
      <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
        <div class="card-body">
          <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
            <h3 class="card-title">{{ project.title }}</h3>
          </a>
          <p class="card-text">{{ project.description }}</p>
          <div class="row ml-1 mr-1 p-0">
            {% if project.github %}
              <div class="github-icon">
                <div class="icon" data-toggle="tooltip" title="Code Repository">
                  <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                </div>
                {% if project.github_stars %}
                  <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                    <i class="fa-solid fa-star"></i>
                    <span id="{{ project.github_stars }}-stars"></span>
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
      {% endunless %}
    </div>
  </div>
</div>

