<div class="news">
  {% if site.failures != blank %}
    {% assign failures_size = site.failures | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and failures_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign failures = site.failures | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign failures_limit = page.announcements.limit %}
        {% else %}
          {% assign failures_limit = failures_size %}
        {% endif %}
        {% for item in failures limit: failures_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
