	url = {https://www.ren21.net/gsr-2024/modules/energy_systems_infrastructure/},
	abstract = {This module explores the status and recent trends of some of the building blocks of the energy system, as well as technology advancements that are enabling the integration of higher shares of variable renewable electricity.

