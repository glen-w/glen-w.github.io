@article{legendreNewYorkCeremonie2025,
	title = {À {New} {York}, une cérémonie acte l’entrée en vigueur début 2026 du traité sur la biodiversité en haute mer},
	url = {https://www.aefinfo.fr/depeche/737833-a-new-york-une-ceremonie-acte-l-entree-en-vigueur-debut-2026-du-traite-sur-la-biodiversite-en-haute-mer},
	abstract = {Les représentants des 68 États ayant à ce jour ratifié le traité sur la préservation et l’utilisation durable de la biodiversité en haute mer se sont réunis le 23 septembre 2025 à New York, en marge de l’Assemblée générale des Nations unies, pour célébrer son entrée en vigueur en janvier prochain. Le traité prévoit la création d’aires marines protégées dans les eaux internationales et la réalisation d’études d’impact environnemental préalables à tout projet. De source diplomatique, la première conférence des parties à ce texte est attendue "à l’automne 2026 au plus tard".},
	language = {fr},
	urldate = {2025-09-26},
	journal = {AEF Info},
	author = {Legendre, Émilie},
	month = sep,
	year = {2025},
	keywords = {french},
	annote = {[language]
French
[quotes]
Le traité prévoit aussi de mettre en place un partage obligatoire des bénéfices issus de l’exploitation des ressources génétiques marines. "La COP décidera du pourcentage auquel les pays développés vont contribuer, mais 50 \% de cette contribution sera destinée à un fonds spécial pour soutenir les pays en développement", décryptait en mars 2023 Glen Wright, chercheur sur la gouvernance internationale de l’océan à l’Iddri.
[role]
interview
quoted
