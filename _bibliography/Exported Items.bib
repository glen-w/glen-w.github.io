@techreport{gjerdeInitialReflectionsSupport2023,
	type = {Policy {Brief}},
	title = {Initial reflections to support rapid, effective and equitable implementation of the {BBNJ} {Agreement}},
	number = {1},
	institution = {IDDRI},
	author = {Gjerde, Kristina M. and Clark, A., Nichola and Chazot, Clément and Cremers, Klaudija and Harden-Davies, Harriet and Kachelriess, Daniel and Payne, Cymie R. and Rodriguez-Chaves, Mariamalia and Spadone, Aurélie and Thiele, Thorsten and Vierros, Marjo and Goettsche-Wanli, Gabriele and Wright, Glen},
