@article{legendreBiodiversiteHauteMer2022b,
	address = {Paris, France},
	title = {Biodiversité en haute mer : cinquième et potentiel dernier round pour...},
	url = {https://www.aefinfo.fr/depeche/677421-biodiversite-en-haute-mer-cinquieme-et-potentiel-dernier-round-pour-les-negociations-sur-le-futur-traite-international},
	abstract = {La 5e et potentielle dernière session de négociations sur le futur traité international sur la conservation et l’utilisation durable de la biodiversité...},
	language = {fr},
	urldate = {2025-09-26},
	journal = {AEF Info},
	author = {Legendre, Émilie},
	month = aug,
	year = {2022},
	annote = {[language]
french
[type]
newspaper
