@inproceedings{CapacityBuildingWorkshop2018,
	address = {307 West 38th Street, New York, NY, USA},
	title = {Capacity {Building} {Workshop}: {UN} {Biodiversity} {Beyond} {National} {Jurisdiction} ({BBNJ}) {Negotiations}},
	publisher = {STRONG High Seas},
