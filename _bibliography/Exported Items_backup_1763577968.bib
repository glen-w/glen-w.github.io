	url = {https://www.france24.com/en/live-news/20230619-much-still-pending-on-how-high-seas-sanctions-will-work},
	abstract = {A new global treaty on the high seas will enable the creation of sanctuaries deemed vital for the oceans, but many questions remain unanswered. Among them: How can we protect marine areas far from the…},
