@article{wrightHighSeasTreaty2023,
	title = {A {High} {Seas} {Treaty} on the {Horizon}: {Progress} and {Prospects} for the {Intergovernmental} {Conference}},
	volume = {37},
	issn = {2211-6001},
	url = {https://brill.com/view/journals/ocyo/37/1/article-p30_3.xml},
	doi = {10.1163/22116001-03701004},
	abstract = {After more than a decade of discussions, States at the United Nations are nearing agreement on a new international legally binding instrument for the conservation and sustainable use of biodiversity in marine areas beyond national jurisdiction. The instrument would resolve longstanding questions over the use of marine genetic resources, put in place a process for the des-ignation of marine protected areas, strengthen the framework for environ-mental impact assessment, and enhance capacity building and technology transfer. 

At the fifth meeting of the Intergovernmental Conference in August 2022, delegations showed significantly more flexibility and made con-siderable progress towards consensus. Many issues nonetheless remained unresolved and the meeting ultimately could not deliver the clean text needed to negotiate the final trade-offs. This short commentary reviews the progress made, identifies key outstanding issues, and highlights the next steps in the process to finalize the high seas treaty.},
	number = {1},
	urldate = {2025-08-11},
	journal = {Ocean Yearbook},
	author = {Wright, Glen and Cremers, Klaudija and Rochette, Julien},
	year = {2023},
	pages = {30--36},
	file = {PDF:/Users/89298/Documents/papers/storage/JGBSTC45/Wright et al. - 2023 - A High Seas Treaty on the Horizon Progress and Pr.pdf:application/pdf},
}

